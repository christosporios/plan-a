# Copy to .env.local and fill in to sync Philips Hue lights with presentation mode.
# .env.local is gitignored, so your bridge key stays out of the repo.
#
#   1. npm run hue      (starts the local relay that talks to the bridge)
#   2. npm run dev      (run the deck locally; lights follow the slide colours)
#
# The relay holds the key — it never reaches the browser. Lights sync only when
# the deck is served over http (localhost); an https page can't reach localhost.

HUE_BRIDGE=https://192.168.1.11          # your Hue bridge, https + IP
HUE_KEY=your-hue-application-key          # hue-application-key
HUE_LIGHTS=id1,id2,id3                    # CLIP v2 light resource ids, comma-separated
VITE_HUE_RELAY=http://localhost:8765      # where the relay listens (browser → relay)
